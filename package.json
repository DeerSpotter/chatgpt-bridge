{
  "name": "chatgpt-browser-bridge-node",
  "version": "6.4.1",
  "description": "Local bridge for ChatGPT web sessions, including a Codex local-harness mode backed by chatgpt-web-provider.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js --server",
    "dev": "node --watch src/index.js --server",
    "interact": "node src/index.js",
    "codex:local": "node scripts/codex-web-provider-local.js",
    "codex:web-provider": "node scripts/codex-web-provider-local.js",
    "codex:extension": "node scripts/codex-local.js",
    "codex:playwright": "node scripts/codex-playwright-local.js",
    "check": "node scripts/check-js.js && node scripts/check-package.js",
    "test": "node --test",
    "test:e2e": "node scripts/e2e-real.js",
    "ui:codex": "node tools/codex-chat-ui/server.js",
    "verify": "node scripts/release-verify.js",
    "extension:install": "node scripts/extension-install.js",
    "workflow:init": "node scripts/workflow-init.js",
    "workflow:worker": "node scripts/workflow-worker.js",
    "check:quality": "node scripts/check-code-quality.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "terlio.js": "1.2.1",
    "ws": "^8.18.0",
    "zipflow": "https://codeload.github.com/balajibj/zipflow/tar.gz/59a5906e5ae3151d274c8f208f1869e978725eb8"
  },
  "bin": {
    "bridge": "bin/bridge.js",
    "chatgpt-bridge": "bin/bridge.js"
  },
  "files": [
    "bin/",
    "src/",
    "tools/chrome-bridge-extension/",
    "tools/codex-chat-ui/",
    "scripts/codex-local.js",
    "scripts/codex-web-provider-local.js",
    "scripts/codex-playwright-local.js",
    "scripts/extension-install.js",
    "scripts/workflow-init.js",
    "scripts/workflow-worker.js",
    "START-LOCAL-AGENT.cmd",
    "bridge.workflow.example.json",
    "systemd/"
  ]
}
